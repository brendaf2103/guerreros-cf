# Copia este archivo a ".env" (sin ".example") y rellena tus datos reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

# ── Django ──
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# ── Base de datos en producción (opcional en tu computadora) ──
# Si la dejas vacía, se usa SQLite local automáticamente.
# En Render/Railway pega aquí la URL de tu base de datos PostgreSQL.
DATABASE_URL=

# ── Cloudinary (opcional) ──
# Crea una cuenta gratis en https://cloudinary.com/users/register/free
# En tu Dashboard verás estos 3 datos listos para copiar y pegar:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
